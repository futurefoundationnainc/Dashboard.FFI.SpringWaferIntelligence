<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS sub-application for the Wafer Map (see deploy/DEPLOY.md).

  One IIS application, e.g. /wafermap -> C:\inetpub\wafermap, runs the Python
  FastAPI service through HttpPlatformHandler. That one process serves both
  the API (/wafermap/api/...) and the built React page (/wafermap/), so the
  dashboards' icon link is simply:
      https://<host>/wafermap/?sample={id}&plan=3d      (3D dashboard)
      https://<host>/wafermap/?sample={id}&plan=2d      (2D dashboard)

  Adjust the paths if the server differs, and replace ##FILE-SERVICE-SAS-URL##.
  WAFERMAP_SAS_URL is a SECRET: set it
  here on the server only (or with the IIS Configuration Editor); never commit it.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- WebDAV answers PUT/DELETE with 405 before the app sees them (same fix as the dashboards' GroupsApi). -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <httpPlatform
        processPath="C:\inetpub\wafermap\backend\.venv\Scripts\python.exe"
        arguments="-m uvicorn app:app --app-dir C:\inetpub\wafermap\backend --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --workers 1 --proxy-headers"
        startupTimeLimit="120"
        startupRetryCount="3"
        requestTimeout="00:10:00"
        processesPerApplication="1"
        stdoutLogEnabled="true"
        stdoutLogFile="C:\WaferMapData\logs\wafermap.log">
      <environmentVariables>
        <!-- The IIS application path; the app strips it so its routes stay /api/... -->
        <environmentVariable name="APP_BASE_PATH" value="/wafermap" />
        <!-- Built frontend (npm run build -> frontend\dist) -->
        <environmentVariable name="STATIC_DIR" value="C:\inetpub\wafermap\frontend\dist" />
        <!-- Layouts + every revision: keep OUTSIDE the app folder so a redeploy never touches them; back it up. -->
        <environmentVariable name="REF_DIR" value="C:\WaferMapData\coordinates" />
        <!-- Day-folder listings and parsed exports (safe to delete; rebuilt on demand). -->
        <environmentVariable name="WAFERMAP_CACHE_DIR" value="C:\WaferMapData\cache" />
        <!-- CloudPCS iXML share. Read + list SAS is enough. -->
        <environmentVariable name="WAFERMAP_SOURCE" value="azure" />
        <environmentVariable name="WAFERMAP_SAS_URL" value="##FILE-SERVICE-SAS-URL##" />
        <environmentVariable name="WAFERMAP_SHARE" value="api-fileshare" />
        <environmentVariable name="WAFERMAP_ROOT" value="risa" />
        <environmentVariable name="WAFERMAP_LOOKBACK_DAYS" value="365" />
        <environmentVariable name="WAFERMAP_LIVE_TTL_SECONDS" value="120" />
        <!-- Day folders older than this are final and their listing is cached for good. Raise it while backfilling. -->
        <environmentVariable name="WAFERMAP_SETTLED_DAYS" value="2" />
        <!-- List the most recent day folders in the background at startup so the first clicks are fast. -->
        <environmentVariable name="WAFERMAP_PREWARM_DAYS" value="14" />
        <!-- Only needed if another origin calls the API; same-origin use needs nothing. -->
        <environmentVariable name="CORS_ORIGINS" value="" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- Layout uploads (CSV/XLSX) can be a few MB. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
