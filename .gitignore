# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node
node_modules/
frontend/dist/
*.local

# Misc
.DS_Store
Thumbs.db

# Excel lock files (workbook open)
~$*

# Layouts saved through the Layouts page are runtime data; only the bundled reference is tracked
backend/coordinates/layouts.json
backend/coordinates/map_filters.json
backend/coordinates/*.csv
backend/coordinates/.*.tmp

# Wafer Map: local stand-in for the file share, and the lookup/parse cache
backend/dev-share/
backend/.cache/
# Real customer iXML samples stay local (the 2D one is ~43 MB)
backend/examples/iXML#*.xml

# Local test data for the Wafer Map (layouts + share cache): never committed
/data/

# Server settings (DataDir, file-share SAS = SECRET); see backend/appsettings.example.json
backend/appsettings.json

# Deployment packages built on this PC to copy to the VM (dist.<commit>, api.<commit>, seed)
/dist/
