<?xml version="1.0" encoding="utf-8"?>
<!-- web.config for the API application: the "api" app nested under the dashboard app
     (/dashboard.waferdefectmapintelligence/api -> <app root>\dist.<tag>\publish\api).
     See backend/DEPLOY.md.

     The 2D / 3D GroupsApi gets this file from `dotnet publish`; a Python app has no
     publish step, so it is checked in whole, with two placeholders that
     deploy/Deploy-WaferMap.ps1 fills in on the server (deploy refuses to start
     while any placeholder is left):

       __API_DIR__    the API folder: <app root>\dist.<tag>\publish\api (this file, app.py, .venv\)
       __DATA_DIR__   the data folder: <app root> (holds layouts\, cache\, logs\)

     HttpPlatformHandler starts uvicorn and forwards every request to it with the
     FULL path (/dashboard.waferdefectmapintelligence/api/...); the app infers its
     path base from "/api/". Settings (DataDir, the file-share SAS) come from
     appsettings.json in the API folder or from app-pool environment variables,
     NOT from this file.

     WebDAV: where IIS has the WebDAV module it sits ahead of the handler and
     claims PUT and DELETE (map filters are saved with PUT, layouts hidden with
     DELETE): 405 while GET works. Removing the module and its handler for THIS
     app only hands the verbs back, the same fix as the GroupsApi's web.config.
     The location wrapper keeps these settings out of any child application. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
      </handlers>
      <httpPlatform
          processPath="__API_DIR__\.venv\Scripts\python.exe"
          arguments="-m uvicorn app:app --app-dir __API_DIR__ --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --workers 1"
          startupTimeLimit="120"
          startupRetryCount="3"
          requestTimeout="00:10:00"
          processesPerApplication="1"
          stdoutLogEnabled="true"
          stdoutLogFile="__DATA_DIR__\logs\api">
        <environmentVariables>
          <!-- The API never serves the frontend under IIS: the dashboard app does. -->
          <environmentVariable name="STATIC_DIR" value="__API_DIR__\no-static" />
        </environmentVariables>
      </httpPlatform>
      <security>
        <requestFiltering>
          <!-- Layout uploads (CSV / XLSX) can be a few MB. -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
