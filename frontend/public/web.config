<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS configuration for the Wafer Defect Map Intelligence static build
     (the dashboard application, e.g. /wafermap). Vite copies this file into
     dist/ on every build, so the deployment folder is IIS-ready as-is.
     Same rules as the 2D / 3D Yield & Defect dashboards' public/web.config. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- remove-before-add avoids 500.19 if the server already maps these -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Always revalidate (Cache-Control: no-cache): index.html keeps its name
           across deploys, so without this the browser shows the previous build
           for hours. An unchanged file costs a 304 with no body. The nested API
           application answers through HttpPlatformHandler, so this does not
           reach it. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <!-- On the server the API sits inside this folder at publish\api (the 2D / 3D layout), and its
         appsettings.json holds the file-share SAS token. The static site must never serve anything
         under publish\: the API is reached at /<app>/api/... (its own nested application), not
         through /<app>/publish/api/... -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="publish" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- Vite puts a content hash in every built JS/CSS filename, so a new build
       is a new URL: these can be cached for a year without going stale. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
